<%- include('includes/head.ejs') %>

<body class="bg-body-tertiary">

<div class="vh-100 d-flex align-items-center">
    <div class="container">
        <div class="row justify-content-center">

            <div class="col-12 col-md-8 col-lg-6 col-xl-5">

                <div class="card border-0 shadow-lg bg-dark text-white rounded-4 overflow-hidden">

                    <!-- Header -->
                    <div class="card-header border-0 bg-dark d-flex align-items-center justify-content-between py-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="rounded-circle bg-success d-inline-block" style="width:10px;height:10px;"></span>
                            <div>
                                <div class="fw-semibold">Register</div>
                                <div class="text-white-50 small">Create your account in two steps</div>
                            </div>
                        </div>

                        <a href="/" class="btn btn-outline-light btn-sm rounded-pill px-3">
                            Login
                        </a>
                    </div>

                    <div class="card-body p-4">

                        <!-- Client Error (JS) -->
                        <div id="clientError" class="alert alert-danger d-none mb-3"></div>

                        <!-- Server Error (Controller) -->
                        <% if (error) { %>
                            <div class="alert alert-danger mb-3"><%= error %></div>
                        <% } %>

                        <!-- STEP 1 -->
                        <form id="step1" method="POST" action="/users/register">
                            <div class="mb-3">
                                <label class="form-label">First Name</label>
                                <input
                                        type="text"
                                        name="firstName"
                                        id="firstName"
                                        class="form-control"
                                        required
                                        minlength="3"
                                        maxlength="32"
                                        pattern="[A-Za-z]+"
                                />

                                <label class="form-label mt-3">Last Name</label>
                                <input
                                        type="text"
                                        name="lastName"
                                        id="lastName"
                                        class="form-control"
                                        required
                                        minlength="3"
                                        maxlength="32"
                                        pattern="[A-Za-z]+"
                                />

                            </div>

                            <div class="mb-3">
                                <label class="form-label text-white-50">Email</label>
                                <input
                                        id="email"
                                        name="email"
                                        type="email"
                                        class="form-control bg-dark text-white border-secondary rounded-3"
                                        placeholder="name@example.com"
                                        required
                                        value="<%= draft ? draft.email : '' %>"
                                        autocomplete="email"
                                >
                            </div>

                            <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-semibold shadow-sm">
                                Next
                            </button>
                        </form>

                        <!-- STEP 2 -->
                        <form
                                id="step2"
                                class="d-none"
                                method="POST"
                                action="/users/register"
                        >
                            <input type="hidden" name="action" value="createUser"/>

                            <div class="mb-3">
                                <label class="form-label text-white-50">Password</label>
                                <input
                                        name="password1"
                                        type="password"
                                        class="form-control bg-dark text-white border-secondary rounded-3"
                                        placeholder="••••••••"
                                        required
                                        minlength="3"
                                        maxlength="32"
                                        autocomplete="new-password"
                                >
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-white-50">Confirm Password</label>
                                <input
                                        name="password2"
                                        type="password"
                                        class="form-control bg-dark text-white border-secondary rounded-3"
                                        placeholder="••••••••"
                                        required
                                        minlength="3"
                                        maxlength="32"
                                        autocomplete="new-password"
                                >
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" id="btnBack" class="btn btn-outline-light w-50 rounded-pill py-2">
                                    Back
                                </button>
                                <button type="submit" class="btn btn-success w-50 rounded-pill py-2 fw-semibold shadow-sm">
                                    Register
                                </button>
                            </div>
                        </form>

                        <div class="text-center mt-3">
                            <a href="/" class="link-light text-decoration-none">
                                Already have an account? <span class="text-success fw-semibold">Login</span>
                            </a>
                        </div>

                    </div>
                </div>

                <div class="text-center mt-3 text-muted small">
                    Two-step registration • Clean UI
                </div>

            </div>
        </div>
    </div>
</div>

<script src="/javascripts/register.js"></script>
<%- include('includes/end.ejs') %>
